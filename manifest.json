{
  "manifest_version": 3,
  "name": "Ebb",
  "description": "Keep social browsing focused by limiting open contexts",
  "version": "1.0.1",
  "action": {
    "default_title": "Ebb",
    "default_icon": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png",
      "48": "images/icon-48.png"
    }
  },
  "options_ui": {
    "page": "options.html",
     "open_in_tab": true
  },
  "permissions": ["tabs","storage"],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  }
}