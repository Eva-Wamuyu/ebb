{
  "manifest_version": 3,
  "name": "Ebb",
  "description": "Keep social browsing focused by limiting open contexts",
  "version": "0.1.0",
  "action": {
    "default_title": "Ebb",
    "default_icon": "Monofeed.png"
  },
  "options_ui": {
    "page": "options.html",
     "open_in_tab": true
  },
  "permissions": ["tabs","storage"],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  }
}